# Copy this file to .env. Never commit .env.
#
# The frontend talks to the Express API in sdpca-server for sign-in and registration.
# Leave VITE_API_BASE_URL unset in development: vite.config.js proxies /api to the local API
# server (see VITE_DEV_API_TARGET there), which keeps the session cookie same-origin.
#
# Set it only when the API lives on another host, and add that browser origin to
# CLIENT_ORIGIN in the API's .env so credentialed requests are allowed:
# VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=

# Development-only: which API origin the Vite proxy forwards /api to.
VITE_DEV_API_TARGET=http://localhost:3000

# "Continue with Google". Firebase Console -> Project settings -> Your apps -> Web app -> Settings,
# then copy the firebaseConfig object. These are public client identifiers, not secrets; a service
# account key must never be placed here. The API server verifies the tokens they produce with its
# own FIREBASE_PROJECT_ID, so projectId must match on both sides.
# Sign-in stays disabled (and the Google button hidden) until the four marked required below are set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional for sign-in; keep them if the project later uses Storage or Cloud Messaging.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
