# Firebase Web app config (Project settings -> Your apps -> SDK setup and configuration).
# Copy this file to .env and paste your own values. Never commit .env.
# These are client-side values by design; access is controlled by Firebase Auth + Security Rules,
# not by keeping them secret. Service account credentials must NEVER be placed here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
